{
  "manifest_version": 3,
  "name": "TorrentLite — Chrome Torrent & Magnet Downloader",
  "version": "1.0.0",
  "description": "Integrasi otomatis pengunduhan torrent & magnet link ke aplikasi TorrentLite Desktop (IDM-Style Konfirmasi Chrome)",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "activeTab",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TorrentLite Downloader"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
